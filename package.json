{
	"name": "gutenberg-form",
	"version": "1.2.1",
	"description": "Wordpress plugin to create forms with Gutenberg blocks",
	"author": "kids-team Österreich",
	"prettier": "@wordpress/prettier-config",
	"license": "GPL-2.0-or-later",
	"main": "assets/index.js",
	"scripts": {
		"build": "wp-scripts build index=src/index.ts frontend=src/frontend.tsx",
		"start": "wp-scripts start index=src/index.ts frontend=src/frontend.tsx",
		"make-pot": "wp i18n make-pot . languages/gutenberg-form.pot --slug=gbf-form-editor --domain=gutenberg-form --exclude=node_modules,src",
		"make-json": "wp i18n make-json languages/ --no-purge",
		"format:js": "biome format --write src package.json biome.json tsconfig.json globals.d.ts",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "biome check src package.json biome.json tsconfig.json globals.d.ts",
		"packages-update": "wp-scripts packages-update",
		"lang": "node ./languages/compile.js",
		"release": "wp-github-plugin gutenberg-form.php --tag"
	},
	"dependencies": {
		"@contexis/wp-react-form": "^2.6.2",
		"@tiptap/pm": "^3.22.3",
		"@tiptap/react": "^3.22.3",
		"@tiptap/starter-kit": "^3.22.3",
		"@types/node": "^18.11.18",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@wordpress/icons": "^10.22.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.5",
		"@types/wordpress__block-editor": "^15.0.6",
		"@types/wordpress__blocks": "^15.10.2",
		"@types/wordpress__core-data": "^2.4.5",
		"@types/wordpress__data": "^6.0.2",
		"@types/wordpress__editor": "^14.3.1",
		"@wordpress/scripts": "^32.4.1",
		"ts-loader": "^9.6.2",
		"typescript": "^6.0.3",
		"wp-github-plugin": "^1.0.4"
	},
	"browserslist": [
		"> 1%",
		"last 3 versions",
		"not dead",
		"not ie <= 11"
	]
}
