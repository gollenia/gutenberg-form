{
	"name": "gutenberg-form/submit",
	"apiVersion": 3,
	"title": "Submit",
	"description": "Lets the user type a short text",
	"textdomain": "gutenberg-form",
	"category": "widgets",
	"attributes": {
		"name": {
			"type": "string",
			"default": "submit"
		},
		"width": {
			"type": "integer",
			"default": 6
		},
		"alignment": {
			"type": "string",
			"default": "right"
		},
		"label": {
			"type": "string",
			"default": ""
		}
	},
	"parent": ["gutenberg-form/form-fields"],
	"supports": {
		"html": false,
		"multiple": false,
		"injector": true
	},
	"editorStyle": "gbf-form-editor-style",
	"editorScript": "gbf-form-editor"
}
